{
  "name": "reignhub",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "check": "pnpm -r --if-present check",
    "test": "pnpm -r --if-present test",
    "build:web": "pnpm --filter @reignhub/site build:worker",
    "build:worker": "pnpm --filter @reignhub/site build:worker",
    "dev": "pnpm --filter @reignhub/site dev",
    "build": "pnpm build:web",
    "deploy": "wrangler deploy && wrangler d1 migrations apply DB --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261110.1",
    "@types/node": "^24.10.0",
    "prettier": "^3.10.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "wrangler": "4.160.0"
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "设备公钥、配对关系与服务签名身份；不保存会话明文。"
      },
      "ROOMS": {
        "description": "设备房间，提供可休眠的信令与加密中继。"
      }
    }
  }
}
