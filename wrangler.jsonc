{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reignhub",
  "main": "apps/self-hosted/src/index.ts",
  "keep_names": false,
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "assets": {
    "directory": "build/self-hosted-assets",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/healthz",
      "/chat",
      "/chat/",
      "/p2p/*",
      "/api/*",
    ],
    "html_handling": "none",
  },
  "d1_databases": [
    { "binding": "DB", "migrations_dir": "packages/worker-core/migrations" },
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RelayRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayRoom"] }],
  "triggers": { "crons": ["17 * * * *"] },
}
