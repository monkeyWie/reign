{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reignhub",
  "main": "apps/site/worker.ts",
  // Theme initialization serializes a function into HTML; avoid injected helpers.
  "keep_names": false,
  "compatibility_date": "2026-03-17",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": {
    "directory": "apps/site/.open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/p2p/*", "/api/*"],
    "html_handling": "none",
  },
  "d1_databases": [
    { "binding": "DB", "migrations_dir": "packages/worker-core/migrations" },
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RelayRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayRoom"] }],
  "triggers": { "crons": ["17 * * * *"] },
}
