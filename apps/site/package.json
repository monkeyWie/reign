{
  "name": "@reign/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "check": "tsc --noEmit && node ../../scripts/platform/check-site-content.mjs",
    "build": "next build",
    "preview": "opennextjs-cloudflare preview",
    "deploy": "wrangler d1 migrations apply DB --remote && opennextjs-cloudflare deploy",
    "build:worker": "opennextjs-cloudflare build",
    "test": "tsx --test test-*.test.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.17",
    "@reign/client-sdk": "workspace:*",
    "@reign/protocol": "workspace:*",
    "@reign/web-client": "workspace:*",
    "@reign/worker-core": "workspace:*",
    "@tailwindcss/postcss": "4.3.0",
    "@types/mdx": "2.0.13",
    "fumadocs-core": "16.19.0",
    "fumadocs-mdx": "15.6.1",
    "fumadocs-ui": "16.19.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.6",
    "rclone.js": "^0.6.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "4.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  }
}
