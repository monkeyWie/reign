{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "reignhub-self-hosted",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reignhub",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/worker-core/migrations",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RelayRoom" }],
  },
  "migrations": [{ "tag": "initial", "new_sqlite_classes": ["RelayRoom"] }],
  "vars": {
    "PUBLIC_STUN": "stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302",
  },
}
