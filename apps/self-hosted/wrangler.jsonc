{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "reignhub-self-hosted",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "assets": {
    "directory": "../../build/self-hosted-assets",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/healthz",
      "/chat",
      "/chat/",
      "/p2p/*",
      "/api/*",
    ],
    "html_handling": "none",
  },
  "triggers": { "crons": ["17 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reignhub",
      "migrations_dir": "../../packages/worker-core/migrations",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RelayRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayRoom"] }],
  "vars": {
    "PUBLIC_STUN": "stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302",
  },
}
