{
  "name": "@reignhub/self-hosted",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@reignhub/worker-core": "workspace:*"
  },
  "scripts": {
    "dev": "node ../../scripts/platform/build-console.mjs --self-hosted && wrangler dev --port 18787",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "build": "node ../../scripts/platform/build-console.mjs --self-hosted && wrangler deploy --dry-run --outdir ../../build/worker",
    "check": "tsc --noEmit"
  }
}
