{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agenthub-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "send_metrics": false,
  "assets": {
    "directory": "../../clients/flutter/build/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/relay", "/healthz", "/v1/*", "/auth/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RelayRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayRoom"] }],
  "observability": { "enabled": false }
}
