# Include inside Nginx's http block (for example, conf.d/agenthub.conf).
# Replace the certificate paths with your existing certificate files.
map $http_upgrade $agenthub_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl;
    server_name ras.lihuipeng.love;

    ssl_certificate /etc/letsencrypt/live/ras.lihuipeng.love/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ras.lihuipeng.love/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:26331;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $agenthub_connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
}

# TCP and UDP STUN use 26330 directly; ordinary HTTP proxying does not forward them.
