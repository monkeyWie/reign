# Install the extracted bundle at /opt/reignhub, then install this file in /etc/systemd/system/.
[Unit]
Description=ReignHub device, signaling, relay and NSGo Web service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/reignhub
ExecStart=/opt/reignhub/reignhub-server --config /etc/reignhub/config.json
DynamicUser=yes
StateDirectory=reignhub
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
UMask=0077
Restart=always
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
