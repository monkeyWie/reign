# Install the extracted bundle at /opt/reign, then install this file in /etc/systemd/system/.
[Unit]
Description=Reign device, signaling, relay and NSGo Web service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/reign
ExecStart=/opt/reign/reign-server --state /var/lib/reign/reign.db
DynamicUser=yes
StateDirectory=reign
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
UMask=0077
Restart=always
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
